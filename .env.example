# Project Paths
# PROJECT_ROOT is auto-detected from the repo location; only set it here to override.
SOURCE_DOCS_PATH=soc
DATA_PATH=data
VECTOR_STORE_PATH=data/vector_store
GRAPH_DB_PATH=data/graph_db
METADATA_DB_PATH=data/metadata.db

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Retrieval Configuration
VECTOR_TOP_K=50
RERANK_TOP_N=10
MAX_CONTEXT_TOKENS=8192

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Web UI Configuration
WEB_UI_PORT=7860

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/rag.log

# Auth & Security
# Required — the app refuses to start without it. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=
SESSION_COOKIE_NAME=rag_session
SESSION_TTL_DAYS=30
COOKIE_SECURE=False
